# ==============================================================================
# SMARTREVIEW - INDEPENDENT DEPLOYMENT ENVIRONMENT CONFIGURATION
# Copy this file to .env.local (for local development) or configure in Vercel settings
# NEVER commit .env.local, service account JSON files, or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & BRANDING
# ------------------------------------------------------------------------------
# The canonical public URL where this SmartReview instance is hosted
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret key for JWT session HMAC-SHA256 signing (minimum 32 random characters in production)
# Generate via: openssl rand -base64 32
JWT_SECRET="generate-a-secure-random-jwt-secret-key-32-chars-min"

# Super Admin email addresses (comma-separated; grants access to /admin-vault)
ADMIN_EMAILS="admin@yourdomain.com"

# ------------------------------------------------------------------------------
# 2. AUTHORITATIVE DATABASE (Your Independent Firebase Firestore Project)
# ------------------------------------------------------------------------------
# Your own Firebase Project ID where all business, user, feedback, and review data will live
FIREBASE_PROJECT_ID="your-independent-firebase-project-id"

# Service Account credentials for server-side Firebase Admin SDK (authoritative Firestore access)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-independent-firebase-project-id.iam.gserviceaccount.com"

# Private key from the generated service account JSON.
# In Vercel / .env, enclose in quotes with newlines escaped as \n (e.g. "-----BEGIN PRIVATE KEY-----\nMIIEvgI...\n-----END PRIVATE KEY-----\n")
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. CLIENT-SIDE AUTHENTICATION (Existing Firebase Auth Project)
# ------------------------------------------------------------------------------
# Preserved configuration for Google Sign-In and client auth verification
# Keep these pointing to the existing authorized authentication project
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyB7nnrGVSUxVTmKw4t6qXrBVxAGbxarVvE"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="saas-64015.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="saas-64015"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="saas-64015.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="308288452293"
NEXT_PUBLIC_FIREBASE_APP_ID="1:308288452293:web:b77eaa4bb8ac1cba5a62ac"

# ------------------------------------------------------------------------------
# 4. AI REVIEW GENERATION (Google Gemini API)
# ------------------------------------------------------------------------------
# Preserved Gemini API integration using your existing API key
# Obtain or verify from: https://aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Leave empty or set to "rzp_test_placeholder" to enable instant built-in Mock Payment mode
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
# Used for password reset emails and instant private feedback alerts
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"SmartReview\" <noreply@yourdomain.com>"

# Optional Gmail App Password fallback if not using custom SMTP:
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""

# ------------------------------------------------------------------------------
# 7. BUILD-TIME COMPATIBILITY (Prisma Schema)
# ------------------------------------------------------------------------------
# Prisma client generation at build time (all runtime data operations use Firestore)
DATABASE_URL="file:./dev.db"
